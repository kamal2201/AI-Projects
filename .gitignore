# =============================================================================
# Root .gitignore for AI-Projects
# =============================================================================

# Environment variables & secrets (NEVER commit secrets or API keys)
.env
.env.local
.env.*.local
*.env
!.env.example

# Operating System files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.Spotlight-V100
.Trashes

# IDE & Editor files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checking & Linters
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Node.js & Frontend builds
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Runtime databases & Vector stores
data/
*.db
*.sqlite
*.sqlite3
chroma_rag/
chroma_mem0/

# Jupyter Notebooks
.ipynb_checkpoints/

# UV package manager
.uv/
